# ==========================================
# CampusConnect Environment Configuration
# ==========================================

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=campusconnect
DB_HOST=localhost
DB_PORT=5432
DB_HOST_PORT=5433

# Full Database URL (for Go Backend)
# When running locally:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campusconnect?sslmode=disable
# When running inside Docker Compose (handled automatically by docker-compose.yml):
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/campusconnect?sslmode=disable

# Security & JWT
JWT_SECRET=supersecret_jwt_key_campusconnect_2026_change_in_production
JWT_EXPIRY_HOURS=24

# Ports
PORT=8080
FRONTEND_PORT=80
VITE_API_URL=http://localhost:8080

# Uploads
UPLOAD_DIR=./uploads
